# Application Configuration
PROJECT_NAME="Geospatial File Measurement API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server
HOST="0.0.0.0"
PORT=8000

# Logging
LOG_LEVEL="INFO"

# Storage & Upload Staging Limits
UPLOAD_DIR="/tmp/geomeasure_staging"
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_ZIP_ENTRIES=100
MAX_EXTRACTED_SIZE_BYTES=209715200
MAX_COMPRESSION_RATIO=100.0

# Resource & Ingestion Safety Limits
MAX_FEATURES_PER_FILE=50000
MAX_COORDINATES_PER_GEOMETRY=500000
MAX_PROPERTY_PAYLOAD_BYTES=65536

# Database
DATABASE_URL="sqlite:///./geomeasure.db"
